NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgresql://user@localhost:5432/sikka

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d

# CORS
CORS_ORIGIN=*

# AWS SNS — OTP SMS delivery.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — IAM user with sns:Publish.
#   When both are set we pass them to the SNS client explicitly. When
#   blank the SDK falls back to its default credential chain (shared
#   config file, IAM role on EC2/ECS, etc.) — that's the path for prod.
# AWS_REGION         — SNS endpoint region (ap-south-1 = Mumbai).
# AWS_SMS_SENDER_ID  — optional alphanumeric sender; India requires DLT
#                      registration. Leave blank for the AWS default.
# SMS_DEV_MODE=true  — skip SNS entirely and log the OTP to stdout.
#                      Server still responds as if the SMS sent.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_SMS_SENDER_ID=
SMS_DEV_MODE=false
